
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  authId    String    @unique
  email     String    @unique
  createdAt DateTime  @default(now())
  avatarUrl String
  username  String    @unique
  goal      Goal?
  mealLogs  MealLog[]
}

model Goal {
  id            String @id @default(cuid())
  userId        String @unique
  dailyCalories Int
  proteinG      Int
  carbsG        Int
  fatG          Int
  user          User   @relation(fields: [userId], references: [id])
}

model MealLog {
  id       String   @id @default(cuid())
  userId   String
  rawInput String
  calories Int
  proteinG Float
  carbsG   Float
  fatG     Float
  items    String[]
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
